{
  "name": "xp-fathom",
  "version": "2.0.0",
  "description": "Fathom for XP",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@enonic-types/core": "8.1.0",
    "@enonic-types/global": "8.1.0",
    "@enonic-types/lib-portal": "8.1.0",
    "@item-enonic-types/nashorn-env": "^0.0.2",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.13.5",
    "concurrently": "^10.0.6",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "release": "changeset publish",
    "versioning": "changeset version && npm i --package-lock-only && node .changeset/gradle-version.mjs"
  }
}
