{
  "name": "xp-fathom",
  "version": "1.2.0",
  "description": "Fathom for XP",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node tsup/anyServerFiles.js && npx tsup -d build/resources/main",
    "check": "node tsup/anyServerFiles.js && npx tsc --noEmit -p src/main/resources/tsconfig.json",
    "watch": "npm run build -- --watch",
    "lint": "biome check --write",
    "release": "npm run build",
    "versioning": "npx changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/version.*/version = ${NEW_VERSION}/\" gradle.properties"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.1",
    "@enonic-types/core": "7.16.8",
    "@enonic-types/global": "^7.16.8",
    "@enonic-types/lib-portal": "^7.16.8",
    "@swc/core": "^1.16.1",
    "@types/node": "^24.13.3",
    "glob": "^13.0.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@swc/core": false,
    "esbuild": false
  }
}
